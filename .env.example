# Cursor automation webhook that hosts Grok Bot
CURSOR_WEBHOOK_URL=
CURSOR_WEBHOOK_API_KEY=
MCP_API_KEY=
INBOUND_WEBHOOK_SECRET=
# Comma-separated allowlist for inbound webhook callback_url targets.
# Unset = every inbound callback_url is rejected (fail closed).
CALLBACK_ALLOWED_HOSTS=
# Pending runs expire after this many seconds (default 3600).
CALLBACK_TTL_SECONDS=
# Delete answered/cancelled/expired runs older than this (default 604800 = 7 days).
# 0 disables time-based run deletion. Pending runs within CALLBACK_TTL_SECONDS are never deleted.
RUN_RETENTION_SECONDS=
# Delete inbound events older than this (default 604800 = 7 days). 0 disables.
EVENT_RETENTION_SECONDS=
# How often to run cleanup (default 300). 0 = startup only, no periodic loop.
CLEANUP_INTERVAL_SECONDS=
# Per-API-key write limit for MCP POST and ask_grokbot/cancel_run (default 30). 0 disables.
RATE_LIMIT_PER_MINUTE=
# Max wait_seconds / timeout_seconds (default 180, hard cap 300).
MAX_WAIT_SECONDS=
